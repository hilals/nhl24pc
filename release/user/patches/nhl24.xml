<!--
  NHL 24 (CUSA37933, APP_VER 01.00) - nhlport game patches, loaded by shadPS4's MemoryPatcher
  (run with  shadPS4.exe -p nhl24.xml ; the file is looked up in <user>/patches/).

  Addresses are eboot.bin virtual addresses with the 0x400000 base the patch repository uses,
  i.e. Address = 0x400000 + file/image offset.
-->
<Patch>
  <Metadata Name="Synchronous replay compression (fixes black ice / frozen gameplay)" isEnabled="true" AppVer="01.00" AppElf="eboot.bin" Author="nhlport">
    <PatchList>
      <!--
        eboot+0x64acb6b: cmp qword ptr [rdi+8], 0 ; je +0x48      (ring->jobSystem == nullptr ?)
        The "rplyCompress" ring enqueue function schedules one compression job per 128 KB block
        through a job queue that the emulated job workers never drain; after 64 blocks the ring
        wraps, waits for the first job forever, the game thread Job3 spins, GameSimulationLoop
        stalls and only the HUD keeps rendering. Turning the conditional jump into an unconditional
        one makes the game take its own synchronous path (compress inline, no job, no wait).
      -->
      <Line Type="byte" Address="0x068ACB70" Value="0xEB"/>
    </PatchList>
  </Metadata>
  <!--
    Same patch for the 1.60 update (APP_VER 01.60). The instruction moved: in the 1.60 eboot.bin the
    "cmp qword ptr [rdi+8], 0 ; je +0x48" is at eboot+0x64e076b, so the je opcode byte is at
    0x68E0770 (checked against the installed 1.60 eboot.bin; the 1.00 entry above is unchanged).
  -->
  <Metadata Name="Synchronous replay compression (fixes black ice / frozen gameplay)" isEnabled="true" AppVer="01.60" AppElf="eboot.bin" Author="nhlport">
    <PatchList>
      <Line Type="byte" Address="0x068E0770" Value="0xEB"/>
    </PatchList>
  </Metadata>
  <!--
    Dynamic resolution off (01.00). GameRenderSettings.DynamicResolutionScaleEnable (field 0x16E): the
    cutscene camera renders at a changing resolution (1600x904, 1624x912, ...) and whole 64-pixel columns of the
    lit scene come out black (see docs/DEVLOG.sk.md, "Znamy problem - ciene obdlniky v prestrihoch").
    Four code sites, found by byte signature (idea and signatures: NHL24PC V3.2 by LEVASTAK, GPL-2.0):
    1) constructor default 1 -> 0, 2-3) member-wise copies read 0, 4) render loop: the regulator jne is NOPed.
    Address = 0x400000 + eboot image offset, same convention as the replay patch above.
  -->
  <Metadata Name="Dynamic resolution off (fixes black columns in cutscenes)" isEnabled="true" AppVer="01.00" AppElf="eboot.bin" Author="nhlport">
    <PatchList>
      <Line Type="byte" Address="0x022C5992" Value="0x00"/>
